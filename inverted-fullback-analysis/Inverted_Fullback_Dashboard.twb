  <dashboards>
    <dashboard name='Dashboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Does the Inverted Fullback Work?</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#fbfbf9' />
        </style-rule>
      </style>
      <size maxheight='1880' maxwidth='1200' minheight='1880' minwidth='1200' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='2' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone fixed-size='104' h='6170' id='3' is-fixed='true' type-v2='text' w='100000' x='0' y='0'>
              <formatted-text>
                <run bold='true' fontcolor='#141414' fontsize='26'>Does the Inverted Fullback Work?
</run>
                <run fontcolor='#52514e' fontsize='12'>11,943 possessions from 198 matches · Euro 2020, World Cup 2022, Euro 2024, Copa America 2024 · same-team, same-match comparisons</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='6' />
              </zone-style>
            </zone>
            <zone fixed-size='96' h='5106' id='4' is-fixed='true' param='horz' type-v2='layout-flow' w='100000' x='0' y='6170'>
              <zone h='5106' id='5' type-v2='text' w='23999' x='0' y='6170'>
                <formatted-text>
                  <run bold='true' fontcolor='#141414' fontsize='22'>11,943&#10;</run>
                  <run fontcolor='#77756f' fontsize='10'>possessions analysed</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='8' />
                  <format attr='background-color' value='#ffffff' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='5106' id='6' type-v2='text' w='24999' x='23999' y='6170'>
                <formatted-text>
                  <run bold='true' fontcolor='#59a14f' fontsize='22'>12% → 18%</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#77756f' fontsize='10'>shot rate, fullback wide → inside</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='8' />
                  <format attr='background-color' value='#ffffff' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='5106' id='7' type-v2='text' w='27333' x='48998' y='6170'>
                <formatted-text>
                  <run bold='true' fontcolor='#59a14f' fontsize='22'>+43%</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#77756f' fontsize='10'>more xG per possession (adjusted)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='8' />
                  <format attr='background-color' value='#ffffff' />
                </zone-style>
              </zone>
              <zone h='5106' id='8' type-v2='text' w='23666' x='76331' y='6170'>
                <formatted-text>
                  <run bold='true' fontcolor='#141414' fontsize='22'>-0.7 pts&#10;</run>
                  <run fontcolor='#77756f' fontsize='10'>opponent shots after a lost ball (no clear change)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='8' />
                  <format attr='background-color' value='#ffffff' />
                </zone-style>
              </zone>
            </zone>
            <zone fixed-size='52' forceUpdate='true' h='3404' id='9' is-fixed='true' type-v2='text' w='100000' x='0' y='11276'>
              <formatted-text>
                <run bold='true' fontcolor='#141414' fontsize='15'>Going inside: effect on the possession</run>
                <run>Æ&#10;</run>
                <run fontcolor='#77756f' fontsize='10'>Dot = estimated difference (inside minus wide), line = 95% confidence interval. Green = all fullbacks, Gray = the five documented inverters.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#77756f' fontsize='10'>Gray compares the five designed inverters&apos; own inside vs. wide possessions. Only &quot;Ends in a shot&quot; is clearly below zero, and the sample is small (52 inside possessions), so treat it as a hint that their job is control, not chance creation.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='6' />
              </zone-style>
            </zone>
            <zone fixed-size='400' h='21915' id='10' is-fixed='true' name='Effect of going inside' show-title='false' w='100000' x='0' y='14680'>
              <layout-cache type-h='cell' type-w='fixed' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='6' />
              </zone-style>
            </zone>
            <zone fixed-size='600' h='29364' id='11' is-fixed='true' param='horz' type-v2='layout-flow' w='100000' x='0' y='36595'>
              <zone h='29364' id='12' param='vert' type-v2='layout-flow' w='43833' x='0' y='36595'>
                <zone fixed-size='52' forceUpdate='true' h='3404' id='13' is-fixed='true' type-v2='text' w='43833' x='0' y='36595'>
                  <formatted-text>
                    <run bold='true' fontcolor='#141414' fontsize='15'>Where a fullback gets the ball</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#77756f' fontsize='10'>Click a player in the ranking to see his middle-third touches. Gray = inside the central channel (shaded), Green = wide. Attacking left to right. Click again to show every fullback.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='6' />
                  </zone-style>
                </zone>
                <zone h='25960' id='15' name='Touch map' show-title='false' w='43833' x='0' y='39999'>
                  <layout-cache minheight='100' minwidth='100' type-h='scalable' type-w='scalable' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone h='29364' id='16' param='vert' type-v2='layout-flow' w='56167' x='43833' y='36595'>
                <zone fixed-size='52' forceUpdate='true' h='3404' id='17' is-fixed='true' type-v2='text' w='56167' x='43833' y='36595'>
                  <formatted-text>
                    <run bold='true' fontcolor='#141414' fontsize='15'>Who goes inside most</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#77756f' fontsize='10'>Top 20 fullbacks by share of middle-third touches received inside (min. 270 minutes)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#77756f' fontsize='10'>Gray = Documented Inverter: an analyst described him rotating into midfield in that tournament (Danilo, WC 2022; Cancelo, Euro 2024)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#77756f' fontsize='10'>Green = Other fullback</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='6' />
                  </zone-style>
                </zone>
                <zone h='25960' id='18' name='Who goes inside most' show-title='false' w='56167' x='43833' y='39999'>
                  <layout-cache cell-count-h='20' minwidth='260' non-cell-size-h='91' type-h='cell' type-w='scalable' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='6' />
                  </zone-style>
                </zone>
              </zone>
            </zone>
            <zone fixed-size='52' forceUpdate='true' h='3404' id='19' is-fixed='true' type-v2='text' w='100000' x='0' y='65959'>
              <formatted-text>
                <run bold='true' fontcolor='#141414' fontsize='15'>Every tournament points the same way</run>
                <run>Æ&#10;</run>
                <run fontcolor='#77756f' fontsize='10'>Change in the chance a possession ends in a shot when the fullback receives inside, all fullbacks.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='6' />
              </zone-style>
            </zone>
            <zone fixed-size='300' h='16595' id='20' is-fixed='true' name='Every tournament' show-title='false' w='100000' x='0' y='69363'>
              <layout-cache type-h='cell' type-w='fixed' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='6' />
              </zone-style>
            </zone>
            <zone fixed-size='252' h='14042' id='21' is-fixed='true' type-v2='text' w='100000' x='0' y='85958'>
              <formatted-text>
                <run fontcolor='#77756f' fontsize='9'>Method: each possession in which a fullback touched the ball in the middle third is labelled inside (first touch in the central channel, y 20-60) or wide, and compared only with possessions by the same team in the same match, adjusting for score, half, touch depth and how the possession started. 95% confidence intervals clustered by match. Documented inverters: fullbacks described as rotating into midfield in published tactical analysis.
</run>
                <run bold='true' fontcolor='#52514e' fontsize='9'>Data: Hudl StatsBomb open data  ·  Analysis: Colin Spelman  ·  Full report and code: github.com/colinspel/colinspel/tree/main/inverted-fullback-analysis</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='6' />
              </zone-style>
            </zone>
          </zone>
        </zone>
        <zone h='25960' id='22' is-scaled='1' param='C:/Users/colin/Downloads/pitch_overlay.png' type-v2='bitmap' w='43833' x='0' y='39999'>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='0' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{2A3AF4D4-6B0A-18E8-830E-07BC1E398F10}' />
    </dashboard>
